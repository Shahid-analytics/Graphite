# Graphite frontend configuration. Copy to .env.local and adjust.
# Never place real credentials in this file - only public, non-secret settings belong here.

# Product name shown in the UI.
VITE_APP_NAME=Graphite

# "mock" serves every request from the in-browser mock API (no backend needed).
# "live" sends every request to VITE_API_BASE_URL. Live mode never falls back to mock data.
VITE_API_MODE=mock

# Base URL of the FastAPI backend (used only when VITE_API_MODE=live).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout in milliseconds for live API calls.
VITE_API_TIMEOUT_MS=20000

# Artificial latency (ms) for mock responses, to exercise loading states.
VITE_MOCK_LATENCY_MS=350
